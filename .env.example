# --- Postgres (used by docker-compose and the Go API) ---
POSTGRES_USER=hflf
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=highfivelowfive

# Host port is 5433 so this never collides with CCGVault's 5432
DATABASE_URL=postgres://hflf:CHANGEME@localhost:5433/highfivelowfive?sslmode=disable

# --- API ---
PORT=8081
JWT_SECRET=CHANGEME
CORS_ORIGIN=http://localhost:5173

# Where uploaded profile pictures are written, and the origin they are served
# back from. Together these are the only thing that knows avatars live on a
# local disk — point them at object storage and nothing else changes.
MEDIA_DIR=../media
PUBLIC_BASE_URL=http://localhost:8081
