# --- Postgres (used by docker-compose and the Go API) ---
POSTGRES_USER=hflf
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=highfivelowfive

# Host port is 5433 so this never collides with CCGVault's 5432
DATABASE_URL=postgres://hflf:CHANGEME@localhost:5433/highfivelowfive?sslmode=disable

# --- API ---
PORT=8081
JWT_SECRET=CHANGEME
CORS_ORIGIN=http://localhost:5173

# Optional: film/TV poster search. Get a free key at
# https://www.themoviedb.org/settings/api — album search needs no key.
TMDB_API_KEY=
